# --- Copy to .env (or set in Render dashboard) ---

# App base URL used to build magic-link / password-reset links
APP_URL=http://localhost:4173

# --- Storage ---
# Preferred: PostgreSQL. The whole workspace state is stored as a single JSONB row,
# giving durable, backup-able storage. When unset, a local JSON file (DATA_DIR) is used
# for tests / local dev.
DATABASE_URL=
# Local JSON fallback location (only used when DATABASE_URL is unset)
# DATA_DIR=.data

# --- Billing / monetization (optional) ---
# Master switch for the payment feature. OFF by default so teachers can test freely;
# flip it ON (via the admin Payments panel, or set to "true" here) once you're ready to
# charge. When OFF, everyone is unlimited and no paywall appears.
# PAYMENTS_ENABLED=false
# Free trial allowance (docs a teacher can create before subscribing) — 5 by default.
# FREE_ALLOWANCE=5
# Monthly subscription price in PHP, and the GCash number where teachers send payment.
# BILLING_PER_MONTH=100
# BILLING_GCASH=09299865338

# --- AI provider (env fallback; admins can also set in-app, which takes precedence) ---
# OpenCode Zen (used automatically when set):
OPENCODE_API_KEY=
# OpenAI (or any OpenAI-compatible endpoint):
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Roles ---
# Comma-separated emails granted the admin role (default bootstrap: betchay.canyas@gmail.com)
ADMIN_EMAILS=

# --- SMTP (magic links & password reset) ---
# Gmail (free, personal account): needs a Google App Password (not your login password).
#   - Enable 2-Step Verification in your Google Account
#   - Create an App Password: Google Account → Security → 2-Step Verification → App passwords
#   - Use that 16-char password here ("xxxx xxxx xxxx xxxx")
# The SENDER ("From") must be your own Gmail address; recipients can be any email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=BLinkMaestra <you@gmail.com>
